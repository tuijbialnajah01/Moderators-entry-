rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} { 
      allow read, write: if false; 
    }
    
    function isSignedIn() { return request.auth != null; }
    
    function isAdmin() {
      return isSignedIn() && 
             (request.auth.token.email.lower() == 'tuijbialnajah@gmail.com' ||
              request.auth.token.email.lower() == 'nadiaparveen1526@gmail.com' ||
              request.auth.token.email.lower() == 'pintrestk11@gmail.com' ||
              request.auth.token.email.lower() == 'kamronbazoz@gmail.com' ||
              request.auth.token.email.lower() == 'kamranaliarts69@gmail.com');
    }

    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    
    function isValidId(id) { 
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    function isValidModCreate(data) {
      return data.keys().hasAll(['name', 'lastEntryAt', 'deadlineAt', 'createdAt', 'updatedAt']) &&
             data.name is string && data.name.size() > 0 && 
             (!('role' in data) || data.role in ['moderator', 'officer']) &&
             (!('officerId' in data) || data.officerId is string || data.officerId == null) &&
             data.lastEntryAt is number &&
             data.deadlineAt is number &&
             data.createdAt is number &&
             data.updatedAt is number;
    }

    match /{path=**}/entries/{entryId} {
      allow list: if true;
    }

    match /mods/{modId} {
      allow get: if true;
      allow list: if true;
      
      allow create: if isAdmin() && isValidModCreate(incoming());
                    
      allow update: if isAdmin() &&
                    ( !('status' in incoming()) || incoming().status in ['active', 'blacklisted'] ) &&
                    ( !('role' in incoming()) || incoming().role in ['moderator', 'officer'] ) &&
                    ( !('officerId' in incoming()) || incoming().officerId is string || incoming().officerId == null ) &&
                    ( !('officerIds' in incoming()) || incoming().officerIds is list ) &&
                    ( !('totalPoints' in incoming()) || incoming().totalPoints is number ) &&
                    ( !('lastEntryAt' in incoming()) || incoming().lastEntryAt is number ) &&
                    ( !('deadlineAt' in incoming()) || incoming().deadlineAt is number ) &&
                    ( !('updatedAt' in incoming()) || incoming().updatedAt is number );
                    
      allow delete: if isAdmin();
      
      match /entries/{entryId} {
        allow get, list: if isAdmin() || get(/databases/$(database)/documents/mods/$(modId)).data.status != 'blacklisted';
        
        function isValidEntry(data) {
          return data.text is string && data.text.size() > 0 && data.text.size() <= 1000 &&
                 (!('createdAt' in data) || data.createdAt is number) &&
                 (!('createdBy' in data) || (data.createdBy is string && data.createdBy.size() <= 128)) &&
                 (!('points' in data) || data.points is number) &&
                 (!('updatedAt' in data) || data.updatedAt is number);
        }

        allow create: if isAdmin() &&
                      isValidId(entryId) &&
                      isValidEntry(incoming()) &&
                      incoming().keys().hasAll(['text', 'createdAt', 'createdBy']) &&
                      incoming().createdBy == request.auth.uid &&
                      existsAfter(/databases/$(database)/documents/mods/$(modId)); 
                      
        allow update: if isAdmin() && isValidEntry(incoming()); 
        allow delete: if isAdmin() && isValidId(entryId);
      }
      match /drafts/{draftId} {
        allow get, list: if isAdmin() || get(/databases/$(database)/documents/mods/$(modId)).data.status != 'blacklisted';
        
        function isValidDraft(data) {
          return data.text is string && data.text.size() > 0 && data.text.size() <= 2000 &&
                 (!('createdAt' in data) || data.createdAt is number) &&
                 (!('createdBy' in data) || (data.createdBy is string && data.createdBy.size() <= 128)) &&
                 (!('points' in data) || data.points is number) &&
                 (!('updatedAt' in data) || data.updatedAt is number);
        }

        allow create: if isAdmin() &&
                      isValidId(draftId) &&
                      isValidDraft(incoming()) &&
                      incoming().keys().hasAll(['text', 'createdAt', 'createdBy']) &&
                      incoming().createdBy == request.auth.uid &&
                      existsAfter(/databases/$(database)/documents/mods/$(modId)); 
                      
        allow update: if isAdmin() && isValidDraft(incoming()); 
        allow delete: if isAdmin() && isValidId(draftId);
      }
    }
  }
}
