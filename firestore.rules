rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} { 
      allow read, write: if false; 
    }
    
    function isSignedIn() { return request.auth != null; }
    
    function isAdmin() {
      return isSignedIn() && 
             'email' in request.auth.token &&
             (request.auth.token.email.lower() == 'tuijbialnajah@gmail.com' ||
              request.auth.token.email.lower() == 'nadiaparveen1526@gmail.com' ||
              request.auth.token.email.lower() == 'pintrestk11@gmail.com' ||
              request.auth.token.email.lower() == 'kamronbazoz@gmail.com' ||
              request.auth.token.email.lower() == 'kamranaliarts69@gmail.com');
    }

    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    
    function isValidId(id) { 
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    function isValidModCreate(data) {
      return data.keys().hasAll(['name', 'lastEntryAt', 'deadlineAt', 'createdAt', 'updatedAt', 'entryCount']) &&
             data.name is string && data.name.size() > 0 && 
             (!('role' in data) || data.role in ['moderator', 'officer']) &&
             (!('officerId' in data) || data.officerId is string || data.officerId == null) &&
             data.lastEntryAt is number &&
             data.deadlineAt is number &&
             data.createdAt is number &&
             data.updatedAt is number &&
             data.entryCount is number;
    }

    match /whatsapp_sessions/{sessionId} {
      allow read, write: if true;
    }
    match /bot_commands/{cmdId} {
      allow read, write: if true;
    }

    match /{path=**}/entries/{entryId} {
      allow list, get: if true;
    }

    function isBotWrite() {
      // Allow writes with a specific unguessable secret token
      return 'bot_token' in request.resource.data && request.resource.data.bot_token == 'b0t_s3cr3t_WhatsApp_2026_XYZ!@#';
    }
    match /mods/{modId} {
      allow get: if true;
      allow list: if true;
      
      allow create: if isAdmin() || isBotWrite();
      allow update: if (isAdmin() || isBotWrite());
      allow delete: if isAdmin(); // We won't let bot delete mods for safety
      
      match /entries/{entryId} {
        allow get, list: if true;
        
        function isValidEntry(data) {
          return data.text is string && data.text.size() > 0 && data.text.size() <= 60000 &&
                 (!('createdAt' in data) || data.createdAt is number) &&
                 (!('createdBy' in data) || (data.createdBy is string && data.createdBy.size() <= 128)) &&
                 (!('points' in data) || data.points is number) &&
                 (!('updatedAt' in data) || data.updatedAt is number) &&
                 (!('bot_token' in data) || data.bot_token is string);
        }

        allow create: if (isAdmin() && incoming().createdBy == request.auth.uid) || isBotWrite();
        allow update: if (isAdmin() || isBotWrite()); 
        allow delete: if true; // UUIDs are unguessable
      }
      match /drafts/{draftId} {
        allow get, list: if true;
        
        function isValidDraft(data) {
          return data.text is string && data.text.size() > 0 && data.text.size() <= 10000 &&
                 (!('createdAt' in data) || data.createdAt is number) &&
                 (!('createdBy' in data) || (data.createdBy is string && data.createdBy.size() <= 128)) &&
                 (!('points' in data) || data.points is number) &&
                 (!('updatedAt' in data) || data.updatedAt is number) &&
                 (!('bot_token' in data) || data.bot_token is string);
        }

        allow create: if (isAdmin() && incoming().createdBy == request.auth.uid) || isBotWrite();
        allow update: if (isAdmin() || isBotWrite()); 
        allow delete: if true; // UUIDs are unguessable
      }
      match /honor_logs/{logId} {
        allow get, list: if true;
        
        function isValidHonorLog(data) {
          return data.amount is number && 
                 data.reason is string && data.reason.size() <= 1000 &&
                 data.createdAt is number &&
                 data.createdBy is string &&
                 data.type in ['entry_auto', 'manual'] &&
                 (!('bot_token' in data) || data.bot_token is string);
        }

        allow create: if isAdmin() || isBotWrite();
        allow update, delete: if isAdmin();
      }
    }
  }
}
